{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "#src/*": ["./src/*"],
      "#openapi": ["./openapi.json"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
