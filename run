#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

select_container_engine() {
  if [[ -n "${CONTAINER_ENGINE:-}" ]]; then
    echo "$CONTAINER_ENGINE"
  elif command -v docker > /dev/null; then
    echo docker
  elif command -v podman > /dev/null; then
    echo podman
  else
    echo 'Install Docker with Compose or Podman with a Compose provider.' >&2
    exit 1
  fi
}

compose() {
  "$container_engine" compose "$@"
}

ensure_environment_file() {
  [[ -f .env ]] || cp .env.example .env
}

remove_development_services() {
  compose kill --signal SIGINT database > /dev/null 2>&1 || true
  compose kill --signal SIGTERM api > /dev/null 2>&1 || true
  sleep 2
  compose kill api > /dev/null 2>&1 || true
  compose kill database > /dev/null 2>&1 || true
  compose down --timeout 1 --remove-orphans > /dev/null 2>&1 || true
}

start_development() {
  ensure_environment_file
  trap 'exit 130' INT TERM HUP
  trap remove_development_services EXIT
  remove_development_services
  compose up --build --detach api
  compose logs --follow api database
}

test_compose() {
  compose --project-name payment-flow-benchmark-tests --profile test "$@"
}

run_tests() {
  test_compose build tests
  test_compose run --rm -T tests
}

run_mutation() {
  mkdir -p reports
  test_compose build mutation
  test_compose run --rm -T mutation npx stryker run "$@"
}

run_npm() {
  compose --profile tools build tooling
  compose --profile tools run --rm -T --no-deps tooling npm ci --no-audit --no-fund
  compose --profile tools run --rm -T --no-deps tooling npm "$@"
}

stop_services() {
  ensure_environment_file
  remove_development_services
  compose --profile tools down
  test_compose kill test-database > /dev/null 2>&1 || true
  test_compose down
}

show_usage() {
  echo 'Usage: ./run [dev|test|mutate|build|format|format:check|npm ...|stop]'
}

container_engine=$(select_container_engine)

case "${1:-dev}" in
  dev)
    start_development
    ;;
  test)
    run_tests
    ;;
  mutate)
    shift
    run_mutation "$@"
    ;;
  build)
    compose build api
    ;;
  format | format:check)
    run_npm run "$1"
    ;;
  npm)
    shift
    run_npm "$@"
    ;;
  stop)
    stop_services
    ;;
  *)
    show_usage >&2
    exit 2
    ;;
esac
