#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

select_container_engine() {
  if [[ -n "${CONTAINER_ENGINE:-}" ]]; then
    echo "$CONTAINER_ENGINE"
  elif command -v docker > /dev/null; then
    echo docker
  elif command -v podman > /dev/null; then
    echo podman
  else
    echo 'Install Docker with Compose or Podman with a Compose provider.' >&2
    exit 1
  fi
}

compose() {
  "$container_engine" compose "$@"
}

start_development() {
  compose up --build api
}

run_tests() {
  compose --profile test build tests
  compose --profile test run --rm -T tests
}

run_formatter() {
  compose --profile tools build tooling
  compose --profile tools run --rm -T --no-deps tooling npm run "$1"
}

stop_services() {
  compose --profile test --profile tools down
}

show_usage() {
  echo 'Usage: ./run [dev|test|build|format|format:check|stop]'
}

container_engine=$(select_container_engine)

case "${1:-dev}" in
  dev)
    start_development
    ;;
  test)
    run_tests
    ;;
  build)
    compose build api
    ;;
  format | format:check)
    run_formatter "$1"
    ;;
  stop)
    stop_services
    ;;
  *)
    show_usage >&2
    exit 2
    ;;
esac
