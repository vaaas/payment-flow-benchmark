{
  "name": "payment-flow-benchmark",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "npm run lint && tsc",
    "start": "node dist/src/main.js",
    "migrate": "tsx src/infrastructure/postgres/migrate.ts",
    "test": "npm run lint && jest --runInBand",
    "format": "prettier --write . run",
    "format:check": "prettier --check . run",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "currency-codes": "2.2.0",
    "drizzle-orm": "0.44.5",
    "express": "5.1.0",
    "pg": "8.16.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.3.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "10.11.0",
    "jest": "30.1.3",
    "prettier": "3.9.6",
    "prettier-plugin-sh": "0.20.2",
    "supertest": "7.1.4",
    "ts-jest": "29.4.14",
    "tsx": "4.20.5",
    "typescript": "6.0.3"
  },
  "imports": {
    "#src/*": "./dist/src/*.js",
    "#openapi": "./dist/openapi.json"
  }
}
